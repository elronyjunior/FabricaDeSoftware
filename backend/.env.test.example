# Valores de exemplo para rodar os testes (npm test) localmente contra um
# Postgres descartável. Copie para ".env.test" e ajuste DB_* para apontar
# para um banco de teste (NUNCA aponte para o banco de produção/dev real).
#
# Rode backend/db/schema.sql nesse banco antes de testar (veja backend/db/README.md).

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fabrica_software_test

JWT_SECRET=test-secret-nao-use-em-producao

# Credenciais falsas do Firebase — apenas para o admin-sdk inicializar sem
# erro durante os testes. Nenhuma chamada real ao Firebase é feita nos testes
# automatizados (login por Google não é coberto pelos testes de integração).
